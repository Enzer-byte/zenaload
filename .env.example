# Never commit real values. Copy to .env.local
PAYMENT_PROVIDER=mock            # mock | paystack | flutterwave
PAYSTACK_API_KEY=sk_test_REPLACE_ME   # PLACEHOLDER: Paystack secret key, add when your business account is approved
FLUTTERWAVE_API_KEY=             # NOT USED YET (Flutterwave provider not built)
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000   # placeholder
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
DATABASE_URL=                    # TODO (Supabase/PostgreSQL)
NEXT_PUBLIC_APP_URL=http://localhost:3000   # PLACEHOLDER: set to your live https domain in production
ADMIN_PASSWORD=REPLACE_ME            # PLACEHOLDER: min 12 chars. Admin stays locked until set
ADMIN_SESSION_SECRET=REPLACE_ME      # PLACEHOLDER: long random string (e.g. `openssl rand -hex 32`)
TOPUP_PROVIDERS=mock                 # priority order, e.g. coda,reloadly. Placeholder-credential suppliers are skipped
CODA_API_BASE_URL=REPLACE_ME         # PLACEHOLDER: from Coda after KYB approval
CODA_API_KEY=REPLACE_ME              # PLACEHOLDER
RELOADLY_API_BASE=REPLACE_ME         # PLACEHOLDER (sandbox first)
RELOADLY_CLIENT_ID=REPLACE_ME        # PLACEHOLDER
RELOADLY_CLIENT_SECRET=REPLACE_ME    # PLACEHOLDER
